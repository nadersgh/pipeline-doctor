# Copy to .env and fill in what you use. Every setting is optional for the local DuckDB demo.

# --- Where to look ---
PIPELINE_DOCTOR_DBT_PROJECT_DIR=demo_workspace/project
PIPELINE_DOCTOR_DUCKDB_PATH=demo_workspace/warehouse.duckdb
PIPELINE_DOCTOR_AIRFLOW_LOG_DIR=demo_workspace/airflow_logs
PIPELINE_DOCTOR_STATE_DIR=.pipeline_doctor
PIPELINE_DOCTOR_GIT_SINCE_REF=pipeline-doctor/last-green

# --- Reasoner: heuristic (offline) | anthropic | openai ---
PIPELINE_DOCTOR_REASONER=heuristic
PIPELINE_DOCTOR_LLM_MODEL=
PIPELINE_DOCTOR_LLM_INPUT_COST_PER_MTOK=3.0
PIPELINE_DOCTOR_LLM_OUTPUT_COST_PER_MTOK=15.0
# JEV decision layer: set ENABLED=false to skip review; LLM judge veto only with an LLM reasoner
PIPELINE_DOCTOR_JEV_ENABLED=true
PIPELINE_DOCTOR_JEV_MIN_CONFIDENCE=0.6
PIPELINE_DOCTOR_JEV_LLM_JUDGE=false
PIPELINE_DOCTOR_JEV_MAX_FIX_REVISIONS=1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Warehouse: duckdb | snowflake (use a role with SELECT-only grants) ---
PIPELINE_DOCTOR_WAREHOUSE=duckdb
PIPELINE_DOCTOR_SNOWFLAKE_ACCOUNT=
PIPELINE_DOCTOR_SNOWFLAKE_USER=
PIPELINE_DOCTOR_SNOWFLAKE_PASSWORD=
PIPELINE_DOCTOR_SNOWFLAKE_ROLE=PIPELINE_DOCTOR_READONLY
PIPELINE_DOCTOR_SNOWFLAKE_WAREHOUSE=
PIPELINE_DOCTOR_SNOWFLAKE_DATABASE=

# --- Guardrails ---
PIPELINE_DOCTOR_ALLOWED_SCHEMAS=["raw","analytics","main"]
PIPELINE_DOCTOR_MAX_QUERIES_PER_INCIDENT=25
PIPELINE_DOCTOR_QUERY_TIMEOUT_SECONDS=30
PIPELINE_DOCTOR_MAX_RESULT_ROWS=200
PIPELINE_DOCTOR_MAX_BYTES_SCANNED=10737418240

# --- Airflow REST API (leave empty to read local task logs) ---
PIPELINE_DOCTOR_AIRFLOW_BASE_URL=
PIPELINE_DOCTOR_AIRFLOW_USERNAME=
PIPELINE_DOCTOR_AIRFLOW_PASSWORD=

# --- Pull requests: local_git | github ---
PIPELINE_DOCTOR_PUBLISHER=local_git
PIPELINE_DOCTOR_GITHUB_TOKEN=
PIPELINE_DOCTOR_GITHUB_REPOSITORY=
PIPELINE_DOCTOR_GITHUB_BASE_BRANCH=main
PIPELINE_DOCTOR_GITHUB_PROJECT_SUBDIR=

# --- API and Slack ---
# Service token for webhooks and incident reads (Airflow sends it as a bearer token).
PIPELINE_DOCTOR_API_TOKEN=
# Reviewer name -> personal token. Approve/reject endpoints are disabled until at least one is set.
PIPELINE_DOCTOR_REVIEWER_TOKENS={}
# Slack users allowed to run `/doctor approve`.
PIPELINE_DOCTOR_SLACK_APPROVERS=[]
PIPELINE_DOCTOR_SLACK_WEBHOOK_URL=
PIPELINE_DOCTOR_SLACK_SIGNING_SECRET=
PIPELINE_DOCTOR_PUBLIC_BASE_URL=http://localhost:8000

# --- Tracing: set to export spans over OTLP (Langfuse, Jaeger, Honeycomb, ...) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public_key:secret_key>
